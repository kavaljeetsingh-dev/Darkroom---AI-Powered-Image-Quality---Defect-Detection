# Copy to .env and adjust as needed. docker-compose.yml reads these.

# Host port the backend API is exposed on
BACKEND_PORT=8000

# Host port the frontend is exposed on
FRONTEND_PORT=3000

# Database connection string used by the backend.
# Default: SQLite file inside the backend_data volume.
# Postgres example:
#   DATABASE_URL=postgresql+psycopg2://user:password@postgres-host:5432/imgquality
DATABASE_URL=sqlite:////app/data/analysis.db

# Comma-separated list of allowed CORS origins for the API (use "*" for any)
CORS_ORIGINS=*

# Must be reachable from the END USER'S BROWSER (not just inside Docker).
# For local docker-compose use, http://localhost:8000 is correct.
# For a cloud deployment, set this to your public backend URL BEFORE
# building the frontend image (it's baked in at build time).
VITE_API_URL=http://localhost:8000
